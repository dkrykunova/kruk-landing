{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kruk-landing",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kruk-landing" }],
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [
    { "pattern": "kruk.marketing", "custom_domain": true },
    { "pattern": "www.kruk.marketing", "custom_domain": true }
  ],
  // Щохвилини — розсилки прогріву; щогодини — повтор запису в Sheets і Brevo
  "triggers": { "crons": ["* * * * *", "15 * * * *"] },
  // Публічні змінні (не секрети). Секрети — через `wrangler secret bulk`.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://kruk.marketing",
    "NEXT_PUBLIC_TG_BOT_USERNAME": "krukapp_bot",
    "NEXT_PUBLIC_TG_CHANNEL_URL": "https://t.me/kruk_ai"
  }
}
